{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keymit: Build Debug",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh",
      "args": ["--profile", "debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Keymit: Build Release",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh",
      "args": ["--profile", "release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
